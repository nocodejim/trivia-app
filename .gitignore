# Real-Time Trivia App .gitignore

# --- Configuration Files ---
# Ignore the actual database config file which contains credentials.
# Only the database.php.example template should be committed.
config/database.php
config/database.php_old

# --- Local Environment & System Files ---
# Mac
.DS_Store
# Windows
Thumbs.db
# IDE & Editor specific files
.idea/
.vscode/

# --- Dependency Directories ---
# Ignore vendor folder for composer dependencies
vendor/
# Ignore node_modules for npm dependencies
node_modules/

# --- Log Files ---
# Ignore all log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker ---
# The persistent database data is managed by Docker volumes, not committed.
# No need to ignore specific files unless you have other local docker artifacts.
